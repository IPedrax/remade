---
import HomePage from "../components/pages/HomePage";
import DirectorySearch from "../components/search/DirectorySearch";
import Layout from "../layouts/Layout.astro";
import { loadCatalog, loadMetadata } from "../lib/catalog";
import { directoryRecords, searchIndex } from "../lib/directory";

const catalog = await loadCatalog();
const metadata = await loadMetadata();
---

<Layout title="Software reimplementations and project requests">
	<HomePage catalog={catalog} metadata={metadata}>
		<DirectorySearch
			records={searchIndex(directoryRecords(catalog, metadata))}
			client:load
		/>
	</HomePage>
</Layout>
