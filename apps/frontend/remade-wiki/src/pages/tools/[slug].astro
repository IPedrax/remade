---
import CopyBadgeDropdown from "../../components/badges/CopyBadgeDropdown";
import ToolPage from "../../components/pages/ToolPage";
import Layout from "../../layouts/Layout.astro";
import { loadCatalog, loadMetadata } from "../../lib/catalog";

export async function getStaticPaths() {
	const catalog = await loadCatalog();

	return catalog.tools.map((tool) => ({
		params: { slug: tool.slug },
		props: { tool, catalog },
	}));
}

const { tool, catalog } = Astro.props;
const metadata = await loadMetadata();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout description={tool.description} index title={tool.name}>
	<ToolPage catalog={catalog} metadata={metadata} tool={tool}>
		<CopyBadgeDropdown projectUrl={canonical} client:load />
	</ToolPage>
</Layout>
