{
	"name": "remade",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "pnpm --filter ./apps/frontend/remade-wiki dev",
		"build": "pnpm --filter ./apps/frontend/remade-wiki build",
		"preview": "pnpm --filter ./apps/frontend/remade-wiki preview",
		"astro": "pnpm --filter ./apps/frontend/remade-wiki astro",
		"check": "pnpm --filter ./apps/frontend/remade-wiki check",
		"format": "pnpm --filter ./apps/frontend/remade-wiki format",
		"test": "pnpm --filter ./apps/frontend/remade-wiki test",
		"test:unit": "pnpm --filter ./apps/frontend/remade-wiki test:unit",
		"test:react": "pnpm --filter ./apps/frontend/remade-wiki test:react",
		"test:e2e": "pnpm --filter ./apps/frontend/remade-wiki test:e2e",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"lefthook": "^2.2.1",
		"miniflare": "5.20261006.1-alpha",
		"vitest": "5.0.3",
		"wrangler": "4.149.0"
	}
}
