{
	"name": "remake-wiki",
	"type": "module",
	"version": "1.0.0",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"format": "biome check --write .",
		"prepare": "lefthook install",
		"test": "pnpm test:unit && pnpm test:react && pnpm test:e2e",
		"test:unit": "vitest run --config tests/vitest.config.ts",
		"test:react": "vitest run --config tests/vitest.react.config.ts",
		"test:e2e": "pnpm build && playwright test"
	},
	"dependencies": {
		"@astrojs/react": "^7.0.1",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/open-sans": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.3.8",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.55.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-dropdown": "^2.0.0",
		"tailwindcss": "^4.3.3",
		"valibot": "^1.5.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/browser-playwright": "^5.0.3",
		"lefthook": "^2.2.1",
		"pagefind": "^1.5.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3",
		"vitest-browser-react": "^2.3.0"
	}
}
